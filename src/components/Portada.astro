---
/*
  Portada: nombre grande a la izquierda (asimétrico, la segunda línea corrida seis
  módulos), y a la derecha una "ficha técnica" de vidrio blanco con un brote dibujado
  a trazo fino. Del pie de la ficha baja una línea que anticipa el árbol de habilidades.
*/
import { persona, ficha, textos } from "../datos.js";
const tx = textos.portada;

const enDesarrollo = import.meta.env.DEV;
// Marcas de una regla: una cada 14 px, más largas cada 5 marcas.
const marcas = Array.from({ length: 41 }, (_, i) => i);
---

<section id="inicio" class="relative min-h-[100svh] pb-[72px] pt-[120px] lg:pt-[168px]">
  <div class="contenedor grid gap-y-[48px] lg:grid-cols-12 lg:gap-x-[28px]">
    <!-- Columna del nombre -->
    <div class="lg:col-span-8">
      <p class="etiqueta flex flex-wrap gap-x-[14px]" data-anim="aparece">
        <span class="text-lima">00</span>
        <span>{persona.ubicacion}</span>
        <span class="hidden text-blanco/55 sm:inline">25°17′ S · 57°38′ O</span>
      </p>

      <h1
        data-anim="nombre"
        class="mt-[24px] font-display text-[clamp(64px,13.5vw,188px)] font-[380] leading-[0.88] tracking-[-0.035em]"
        style="font-variation-settings: 'opsz' 144, 'SOFT' 30;"
      >
        <span class="block overflow-hidden pb-[0.06em]"><span class="block">{persona.nombre}</span></span>
        <span class="block overflow-hidden pb-[0.08em] pl-[42px] sm:pl-[84px]"
          ><span class="block italic text-blanco/90" style="font-variation-settings: 'opsz' 144, 'SOFT' 100, 'WONK' 1;"
            >{persona.apellido}</span
          ></span
        >
      </h1>

      <!-- Regla técnica bajo el nombre: los trazos se dibujan al cargar -->
      <svg class="mt-[12px] block h-[24px] w-full max-w-[560px] overflow-visible" aria-hidden="true">
        <line data-anim="trazo" x1="0" y1="0.5" x2="560" y2="0.5" stroke="rgb(245 247 242 / .5)" stroke-width="1" />
        {
          marcas.map((i) => (
            <line x1={i * 14 + 0.5} y1="0" x2={i * 14 + 0.5} y2={i % 5 === 0 ? 9 : 4} stroke="rgb(245 247 242 / .35)" />
          ))
        }
      </svg>

      <div class="mt-[24px] max-w-[588px] sm:pl-[84px]">
        <p class="text-[19px] leading-[28px] text-blanco" data-anim="aparece">
          {persona.titulo}
          <span class="etiqueta ml-[4px] whitespace-nowrap !normal-case !text-lima">/ {persona.enfasis}</span>
        </p>

        {
          persona.frase ? (
            <p class="mt-[24px] font-display text-[24px] italic leading-[32px] text-blanco/80" data-anim="aparece">
              {persona.frase}
            </p>
          ) : (
            enDesarrollo && (
              <p class="etiqueta mt-[24px] rounded-[6px] border border-dashed border-lima/50 p-[14px] !normal-case">
                TODO · Falta la frase de portada. Se completa en src/datos.js → persona.frase (solo visible en desarrollo).
              </p>
            )
          )
        }

        <div class="mt-[48px] flex flex-wrap items-center gap-x-[28px] gap-y-[14px]" data-anim="aparece">
          <a
            href="#proyectos"
            class="boton group inline-flex h-[48px] items-center gap-[14px] rounded-[6px] bg-lima px-[21px] font-medium text-tinta"
          >
            {tx.ctaPrincipal}
            <svg width="14" height="10" viewBox="0 0 14 10" aria-hidden="true" class="transition-transform group-hover:translate-x-[3px]">
              <path d="M0 5h12M8 1l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.4" />
            </svg>
          </a>
          <a href="#contacto" class="subrayado pb-[2px] text-blanco/85 hover:text-blanco">{tx.ctaSecundario}</a>
        </div>
      </div>
    </div>

    <!-- Columna de la ficha -->
    <div class="relative lg:col-span-4 lg:pt-[96px]">
      <!-- Losa de vidrio oscuro detrás, corrida: da profundidad y lleva la refracción -->
      <div
        class="vidrio refracta pointer-events-none absolute -right-[14px] top-[-28px] h-[62%] w-[72%] bg-gradient-to-b from-white/[.07] to-bosque/40 lg:top-[56px]"
        aria-hidden="true"
      >
      </div>

      <article
        data-anim="ficha"
        class="vidrio vidrio--blanco especular relative ml-auto max-w-[392px] p-[21px] lg:-ml-[14px]"
        aria-label="Ficha técnica"
      >
        <!-- Marcas de registro en las esquinas, como en un plano -->
        <span class="registro -left-[7px] -top-[7px]" aria-hidden="true"></span>
        <span class="registro -right-[7px] -top-[7px]" aria-hidden="true"></span>
        <span class="registro -bottom-[7px] -left-[7px]" aria-hidden="true"></span>
        <span class="registro -bottom-[7px] -right-[7px]" aria-hidden="true"></span>

        <header class="flex items-baseline justify-between font-mono text-[11px] uppercase tracking-[0.06em] text-tinta/70">
          <span>{tx.ficha}</span>
          <span>RM · 2026</span>
        </header>

        <figure class="mt-[14px] overflow-hidden rounded-[4px] border border-black">
          {
            persona.foto ? (
              <img src={persona.foto} alt={`Foto de ${persona.nombre} ${persona.apellido}`} class="aspect-[4/3] w-full object-cover" width="392" height="294" />
            ) : (
              <svg viewBox="0 0 350 240" class="block aspect-[350/240] w-full bg-[#eef1ea]" role="img" aria-label="Dibujo de un brote">
                <defs>
                  <pattern id="puntos" width="14" height="24" patternUnits="userSpaceOnUse">
                    <circle cx="0.75" cy="0.75" r="0.75" fill="rgb(10 13 11 / .22)" />
                  </pattern>
                </defs>
                <rect width="350" height="240" fill="url(#puntos)" />
                <g fill="none" stroke="#0a0d0b" stroke-width="1.1" stroke-linecap="round">
                  <path data-anim="trazo" d="M168 240 C168 200 170 176 175 150 C179 128 178 112 175 96" />
                  <path data-anim="trazo" d="M174 150 C152 140 132 140 112 120 C134 114 156 122 174 150" />
                  <path data-anim="trazo" d="M176 118 C192 104 214 98 238 100 C226 120 204 126 176 118" />
                  <path data-anim="trazo" d="M175 96 C170 84 172 72 180 62" />
                  <path d="M60 240 H290" stroke-dasharray="2 5" />
                </g>
                <circle data-anim="nodo" cx="180" cy="62" r="4" fill="#b7d88c" stroke="#0a0d0b" />
                <text x="14" y="22" font-family="JetBrains Mono, monospace" font-size="10" fill="rgb(10 13 11 / .6)">{tx.figura.toUpperCase()}</text>
                <text x="14" y="228" font-family="JetBrains Mono, monospace" font-size="10" fill="rgb(10 13 11 / .6)">h = 2026</text>
              </svg>
            )
          }
        </figure>

        <dl class="mt-[14px] divide-y divide-black/15 border-y border-black/15">
          {
            ficha.map((f) => (
              <div class="grid grid-cols-[98px_1fr] gap-x-[14px] py-[9px] text-[15px] leading-[22px]">
                <dt class="pt-[1px] font-mono text-[11px] uppercase tracking-[0.06em] text-tinta/70">{f.clave}</dt>
                <dd>{f.valor}</dd>
              </div>
            ))
          }
        </dl>

        <p class="mt-[14px] flex items-center gap-[10px] font-mono text-[11px] uppercase tracking-[0.06em] text-tinta/80">
          <span class="size-[8px] rounded-full bg-lima ring-1 ring-black" aria-hidden="true"></span>
          {tx.estadoFicha}
        </p>
      </article>

      <!-- La línea que baja hacia el árbol -->
      <a href="#habilidades" class="group relative ml-auto mt-[12px] flex max-w-[392px] items-end gap-[14px] lg:-ml-[14px]">
        <svg width="15" height="120" viewBox="0 0 15 120" class="ml-[48px] shrink-0 overflow-visible" aria-hidden="true">
          <path data-anim="trazo" d="M7.5 0 V108" stroke="rgb(245 247 242 / .6)" stroke-width="1" />
          <circle data-anim="nodo" cx="7.5" cy="112" r="4" fill="none" stroke="#b7d88c" class="transition-all group-hover:fill-[#b7d88c]" />
        </svg>
        <span class="etiqueta pb-[4px] transition-colors group-hover:!text-blanco">
          <span class="text-lima">01</span> {tx.siguiente}
        </span>
      </a>
    </div>
  </div>
</section>

<style>
  .registro {
    position: absolute;
    width: 13px;
    height: 13px;
    background:
      linear-gradient(var(--color-blanco), var(--color-blanco)) center / 1px 100% no-repeat,
      linear-gradient(var(--color-blanco), var(--color-blanco)) center / 100% 1px no-repeat;
    opacity: 0.7;
  }
  .boton {
    transition:
      background-color 0.25s,
      box-shadow 0.25s;
  }
  .boton:hover {
    background: #c6e3a0;
    box-shadow: 0 0 0 4px rgb(183 216 140 / 0.18);
  }
</style>

<script>
  import { animarPortada } from "../scripts/animaciones.js";
  animarPortada();
</script>
